# Copy to .env (gitignored). docker compose passes these to the dagster
# service; for host runs use `set -a; . ./.env; set +a`.
# Defaults live in dawgpath_data_pipeline/conf/settings.py.

# DB_CLASS=sqlite3            # sqlite3, memory, or postgres
# DB_FILE=db.sqlite
# DB_DEBUG=False
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=dawgpath

EDW_SERVER=
EDW_USER=
EDW_PASSWORD=

AZSQL_USER=
AZSQL_PASSWORD=

# SWS_ENV picks the host (EVAL or PROD); RESTCLIENTS_SWS_HOST overrides it.
SWS_ENV=EVAL
RESTCLIENTS_SWS_CERT_FILE=/secrets/compass-uwca.cert
RESTCLIENTS_SWS_KEY_FILE=/secrets/compass-uwca.key

# GCS_BUCKET_NAME=            # unset writes artifacts locally
